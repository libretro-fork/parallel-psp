#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D luma;
layout(binding = 1) uniform sampler2D chroma;
layout(rgba8, binding = 2) writeonly uniform image2D destination;
layout(rgba8, binding = 3) writeonly uniform image2D originalPlanes;
layout(push_constant) uniform Size { ivec2 size; } pc;
void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(p, pc.size))) return;
	int y = int(round(texelFetch(luma, p, 0).r * 255.0)) - 16;
	ivec2 uv = ivec2(round(texelFetch(chroma, p / 2, 0).rg * 255.0)) - 128;
	imageStore(originalPlanes, p, vec4(y + 16, uv + 128, 0) / 255.0);
	int c = 298 * y + 128;
	ivec3 rgb = clamp(ivec3(c + 409 * uv.y, c - 100 * uv.x - 208 * uv.y, c + 516 * uv.x) >> 8,
		ivec3(0), ivec3(255));
	imageStore(destination, p, vec4(rgb, 0) / 255.0);
}
